// --- Rooming Module ---
/// A double room, formed on the main site the way teams are: the owner creates
/// it and their roommate joins with its code. Owned by the backend's
/// migrations, which dropped the old size/status columns and the invitations
/// table; read-only here.
model Room {
  id        String        @id @default(uuid())
  code      String        @unique // 6 characters; rooms have no name
  gender    String // 'male' | 'female', copied from the owner on creation
  ownerId   String        @unique @map("owner_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  // Relations
  owner     Participant   @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Everyone in the room, owner included — at most 2, enforced by the backend.
  residents Participant[] @relation("RoomResidents")

  @@map("rooms")
}

