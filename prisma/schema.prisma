// Prisma schema for TRSYP 3.0
// Uses PostgreSQL via Supabase

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Each domain module owns its own models.
// Models are organized by module boundary.
// No cross-module entity references — use domain events for inter-module comms.
// ============================================================================

// --- Auth Module ---
// Define auth-related models here
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  lastName   String
  supabaseId String   @unique
  provider   String   @default("email")
  /// The main website's half-human, half-robot avatar settings (its
  /// AvatarConfig). Owned by the main site's migrations; read-only here.
  avatar     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  active     Boolean  @default(false)

  // Relations
  participant   Participant?
  activateToken ActivateToken?

  @@map("users")
}

model ActivateToken {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  activatedAt DateTime? @map("activated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activate_tokens")
}

enum Position {
  CHAIR
  VICE_CHAIR
  // add more as needed
}

model Admin {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  lastName   String
  position   Position
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supabaseId String   @unique

  @@map("admins")
}

// --- Registration Module ---
model Participant {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  ieeeId            Int?               @unique @map("ieee_id")
  phone             String             @unique
  gender            String
  paid              Boolean            @default(false)
  isInternational   Boolean            @default(false) @map("is_international")
  banned            Boolean            @default(false)
  // Added by backend migrations 20260816000000_add_participant_is_ras and
  // 20260918000000_add_participant_facebook_link; this schema was stale.
  isRas             Boolean            @default(false) @map("is_ras")
  facebookLink      String?            @map("facebook_link")
  // Agreed exception to the fee table, in TND (backend migration
  // 20261011000000_add_participant_fee_override). Null when priced normally.
  feeOverride       Int?               @map("fee_override")
  // IEEE's verdict, not the participant's claim: the main website sets
  // participant_type and is_ras from the ieee_verifications row.
  participantType   ParticipantType    @map("participant_type")
  // The participant's own answer (added by the main backend). Decides Student
  // vs YoungProfessional pricing for IEEE members; separate from the verdict.
  careerStage       CareerStage?       @map("career_stage")
  sb                SB?
  country           COUNTRY
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  ownedRoom         Room?              @relation("RoomOwner")
  // Set on both people in a room, owner included. The column really is
  // camelCase ("roomId"), unlike the rest of the table.
  room              Room?              @relation("RoomResidents", fields: [roomId], references: [id])
  roomId            String?
  // Relations
  // A participant may belong to at most one team per activity — the cap is a
  // DB-level unique on TeamMembership(participant_id, activity).
  memberships       TeamMembership[]
  ledTeams          Team[]             @relation("TeamLeader")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  internationalInfo InternationalInfo? @relation("ParticipantInternationalInfo")
  ieeeVerification  IeeeVerification?

  @@map("participants")
}

model Team {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  size      Int // max capacity — enforced at service level
  activity  TeamActivity @default(COMPETITION) // which event this team competes in
  axis          FablabAxis? // FABLAB teams only — the axis the leader chose
  submissionUrl String?     @map("submission_url") // FABLAB only — Google Drive folder of the concept dossier
  submittedAt   DateTime?   @map("submitted_at") // when submissionUrl was last set
  leaderId  String       @map("leader_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  leader      Participant      @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]

  // One led team per activity — a leader can head a competition team *and* a
  // challenge team, but never two of the same kind.
  @@unique([leaderId, activity])
  @@map("teams")
}

/// Join row between a participant and a team.
/// `activity` is denormalised from `Team.activity` (a team's activity never
/// changes after creation) so the "one team per activity" rule can be enforced
/// by a unique index instead of application code.
model TeamMembership {
  id            String       @id @default(uuid())
  participantId String       @map("participant_id")
  teamId        String       @map("team_id")
  activity      TeamActivity
  createdAt     DateTime     @default(now()) @map("created_at")

  // Relations
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([participantId, activity])
  @@unique([participantId, teamId])
  @@index([teamId])
  @@map("team_memberships")
}

model InternationalInfo {
  id                    String   @id @default(uuid())
  participantId         String   @unique @map("participant_id")
  dateOfBirth           DateTime @map("date_of_birth")
  countryOfResidence    String   @map("country_of_residence")
  cityOfResidence       String   @map("city_of_residence")
  affiliation           String
  expectedArrivalDate   DateTime @map("expected_arrival_date")
  expectedDepartureDate DateTime @map("expected_departure_date")
  requiresVisaLetter    Boolean  @default(false) @map("requires_visa_letter")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  participant     Participant      @relation("ParticipantInternationalInfo", fields: [participantId], references: [id], onDelete: Cascade)
  visaApplication VisaApplication? @relation("InternationalInfoVisaApplication")

  @@map("international_info")
}

model VisaApplication {
  id                      String     @id @default(uuid())
  internationalInfoId     String     @unique @map("international_info_id")
  passportNumber          String     @unique @map("passport_number")
  passportIssuanceCountry String     @map("passport_issuance_country")
  issuingOffice           String     @map("issuing_office")
  passportIssuanceDate    DateTime   @map("passport_issuance_date")
  passportExpiryDate      DateTime   @map("passport_expiry_date")
  embassyAddress          String     @map("embassy_address")
  residenceAddress        String     @map("residence_address")
  status                  VisaStatus @default(Pending)
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  // Relations
  internationalInfo InternationalInfo @relation("InternationalInfoVisaApplication", fields: [internationalInfoId], references: [id], onDelete: Cascade)

  @@map("visa_applications")
}

// --- Admin Portal Module ---
/// Latest IEEE GetMemberStatus check per participant. Owned by the admin
/// portal, not the backend: created by prisma/sql/ieee_verifications.sql.
/// The claimed_* columns snapshot what the participant registered as when the
/// check ran, so a later edit to any of them marks the result stale.
model IeeeVerification {
  id            String          @id @default(uuid())
  participantId String          @unique @map("participant_id")
  status        IeeeCheckStatus
  memberStatus  String?         @map("member_status")
  grade         String?
  societies     String[]        @default([])
  firstInitial  String?         @map("first_initial")
  lastInitial   String?         @map("last_initial")
  matchedBy     String?         @map("matched_by") // 'IEEE_ID' | 'EMAIL'
  issues        Json            @default("[]") // IeeeIssue[]
  claimedIeeeId Int?            @map("claimed_ieee_id")
  claimedType   String          @map("claimed_type")
  claimedIsRas  Boolean         @map("claimed_is_ras")
  claimedEmail  String          @map("claimed_email")
  checkedAt     DateTime        @default(now()) @map("checked_at")
  checkedBy     String          @map("checked_by") // admins.id

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("ieee_verifications")
}

/// The competition draw's result, one row per match. Owned by the admin
/// portal, not the backend: created by prisma/sql/competition_draw.sql. Each
/// new draw replaces all four rows. Teams are stored by their key in
/// src/app/draw/teams.ts.
model CompetitionDrawMatch {
  matchNumber Int      @id @map("match_number")
  greenTeam   String   @map("green_team")
  pinkTeam    String   @map("pink_team")
  drawnAt     DateTime @default(now()) @map("drawn_at")
  drawnBy     String   @map("drawn_by") // admins.id

  @@map("competition_draw_matches")
}

// --- ArUco challenge ---
// Owned by the backend's migrations (20261011000000_aruco_collector_progress,
// 20261012000000_aruco_scans, 20261017000000_aruco_markers); the portal edits
// the register and can wipe a team's progress.

/// What scanning one ArUco ID (DICT_4X4_50, 0-49) gives on the main site's
/// /aruco page. An ID with no row isn't a marker. CHECK constraints keep
/// `quantity` to beacons and `collector` (1 or 2) to collectors.
model ArucoMarker {
  markerId  Int      @id @map("marker_id")
  kind      String // beacon | indicator | collector
  game      String // Garden | Mine
  name      String
  clue      String   @default("")
  quantity  Int?
  collector Int?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("aruco_markers")
}

/// A distinct marker ID a Competition team has tried, real or not.
model ArucoScan {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  markerId  Int      @map("marker_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, markerId])
  @@map("aruco_scans")
}

/// A Competition team's attempts on one collector (1 or 2). The words typed
/// are not stored, only how many attempts were used and whether one was right.
model ArucoCollectorProgress {
  id        String    @id @default(uuid())
  teamId    String    @map("team_id")
  collector Int
  solved    Boolean   @default(false)
  attempts  Int       @default(0)
  solvedAt  DateTime? @map("solved_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([teamId, collector])
  @@map("aruco_collector_progress")
}

// Enums

enum IeeeCheckStatus {
