# Supabase project (same project as TRSYP 3.0 backend)
SUPABASE_URL=https://nvkzioyjxrsxhjlpwyqn.supabase.co

# Public — safe to expose to the browser. Used for login (Google OAuth +
# email/password) and session handling. NOT the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://nvkzioyjxrsxhjlpwyqn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never NEXT_PUBLIC_. Bypasses RLS.
# Get from Supabase dashboard > Project Settings > API.
# ⚠️ Rotate immediately if this ever leaks (chat, git history, screenshot, etc).
SUPABASE_SERVICE_ROLE_KEY=

# Database (same Supabase Postgres instance as the backend)
# Pooled connection (pgbouncer) — used at runtime via the pg driver adapter.
DATABASE_URL=
# Direct connection — used by Prisma CLI (generate/introspect), not pooled.
DIRECT_URL=
